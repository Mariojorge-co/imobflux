# Copie para .env na VM e preencha. NUNCA versione o .env.
# DOMAIN: use o IP estático com pontos trocados por traços + .sslip.io (ex.: 34-12-56-78.sslip.io),
# ou um domínio seu apontado para o IP.
DOMAIN=
# Chave de acesso da Evolution (a mesma vai para EVOLUTION_API_KEY no Vercel). Gere com: openssl rand -hex 32
AUTHENTICATION_API_KEY=
# Senha do Postgres interno. Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=
