# Copie para .env na VPS e preencha. NUNCA versione o .env.
# DOMAIN: o IP da VPS com pontos trocados por traços + .sslip.io (ex.: IP 207.180.252.4 vira
# 207-180-252-4.sslip.io), ou um domínio seu apontado para o IP.
DOMAIN=
# Chave de acesso da Evolution (a mesma vai para EVOLUTION_API_KEY no Vercel). Gere com: openssl rand -hex 32
AUTHENTICATION_API_KEY=
# Senha do Postgres interno. Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=
