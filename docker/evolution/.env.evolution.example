# Configuração de Ambiente para a Stack Evolution API v2.3.7

# Chave Global de Autenticação da API (min. 32 caracteres recomendados)
AUTHENTICATION_API_KEY=imobflux_evolution_global_dev_api_key_32chars

# Credenciais e Conexão do PostgreSQL Isolado
POSTGRES_USER=evolution
POSTGRES_PASSWORD=evolution_db_secret_pass_2026
POSTGRES_DB=evolution_db
DATABASE_CONNECTION_URI=postgresql://evolution:evolution_db_secret_pass_2026@evolution-postgres:5432/evolution_db?schema=public

# Credenciais e Conexão do Redis Isolado
REDIS_PASSWORD=evolution_redis_secret_pass_2026
CACHE_REDIS_URI=redis://:evolution_redis_secret_pass_2026@evolution-redis:6379/0

# Segredo de Webhook (usado na validação do header x-evolution-secret)
EVOLUTION_WEBHOOK_SECRET=imobflux_webhook_secret_dev_key_2026
