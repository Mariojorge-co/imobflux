# Public Supabase API URL. Local example: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Low-privilege browser key. Accepts a local anon/publishable key or a hosted
# publishable key without changing application code.
NEXT_PUBLIC_SUPABASE_CLIENT_KEY=

# Server-only administrative key. Accepts a local service_role/secret key or a
# hosted secret key. Never expose this variable to browser code.
SUPABASE_ADMIN_KEY=

# Server-only, high-entropy token for the one-time initial setup.
IMOBFLUX_BOOTSTRAP_TOKEN=
